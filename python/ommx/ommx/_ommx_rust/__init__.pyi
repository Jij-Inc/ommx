    ... x = instance.new_binary(\"x\")
    ... y = instance.new_binary(\"y\")
    ... instance.objective = 3 * x + 2 * y
    ... instance.add_constraint(x + y <= 1)
    ... solution = instance.evaluate({x.id: 1, y.id: 0})
    ... assert solution.feasible and solution.objective == 3
    ...
