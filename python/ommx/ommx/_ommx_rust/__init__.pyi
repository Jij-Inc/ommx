    def __copy__(self) -> OneHotConstraintID:
        r"""
        IDs are immutable; copying preserves the same typed identity.
        """
    def __deepcopy__(self, _memo: typing.Any) -> OneHotConstraintID:
        r"""
        IDs are immutable, including when nested in copied containers.
        """

@typing.final
class OpenSolve:
    r"""
    Context manager for a manually executed Solve inside a Run.

    `OpenSolve` is returned by `Run.open_solve(...)`. Use `solver_input` to
    access the backend solver model, run backend-specific APIs, decode the
    solver output, and record adapter options that are set directly on the
    backend model. The Solve entry is finalized when the context exits.

    Most recording uses {meth}`Run.log_solve`. Use this scope when a backend API
    must be called directly. Options set through the backend do not automatically
    become stored metadata; record them with {meth}`log_adapter_option`.

    This complete example requires the HiGHS Adapter:

    ```pycon
    >>> from ommx import Instance
    >>> from ommx.experiment import Experiment
    >>> from ommx_highs_adapter import OMMXHighsAdapter
    >>> problem = Instance.minimize()
    >>> x = problem.new_binary("x")
    >>> problem.objective = x
    >>> with Experiment.with_temp_local_registry() as experiment:
    ...     with experiment.run() as run:
    ...         with run.open_solve(OMMXHighsAdapter, problem, verbose=False) as solve:
    ...             model = solve.solver_input
    ...             _ = model.setOptionValue("time_limit", 10.0)
    ...             solve.log_adapter_option("time_limit", 10.0)
    ...             _ = model.run()
    ...             solution = solve.decode(model)
    ...             assert solution.feasible
    >>> recorded = experiment.runs[0].solves[0]
    >>> recorded.output.objective
    0.0
    >>> recorded.adapter_options["time_limit"]
    10.0

    ```

    {meth}`decode` stores the decoded Solution as the Solve's output. The context
    manager finalizes the record on exit; the individual methods document terminal
    states, diagnostics, tracing, and exceptional exits. A finished recording
    scope is distinct from a guarantee of candidate feasibility or optimality.
    """
    @property
    def solve_id(self) -> builtins.int:
        r"""
        Reserved Solve ID for this manual Solve.
        """
    @property
    def terminal_state(
        self,
    ) -> typing.Optional[builtins.dict[builtins.str, typing.Any]]:
        r"""
        Terminal state recorded when this manual Solve scope closes.

        Returns `None` until the context has closed. After closing, this exposes
        the recorded Solve outcome together with trace and diagnostics
        finalization states for advanced debugging.
        """
    @property
    def solver_input(self) -> typing.Any:
        r"""
        Backend solver model generated by the adapter.
        """
    @property
    def adapter(self) -> typing.Any:
        r"""
        Adapter instance used by this manual Solve.
        """
    @property
    def diagnostics(self) -> typing.Optional[DiagnosticCollector]:
        r"""
        Diagnostics collector stored with this Solve, or `None` when disabled.
        """
    def __enter__(self) -> OpenSolve: ...
    def __exit__(
        self,
        exc_type: typing.Optional[typing.Any] = None,
        exc_value: typing.Optional[typing.Any] = None,
        traceback: typing.Optional[typing.Any] = None,
    ) -> builtins.bool: ...
    def decode(self, data: typing.Any) -> Solution:
        r"""
        Decode backend solver output through the adapter.

        The decoded Solution is kept as this scope's finished output candidate.
        The Solve entry is recorded when the `OpenSolve` context exits, so
        diagnostics and annotations can still be recorded after this call and
        before the end of the `with` block.
        """
    def log_adapter_option(self, name: builtins.str, value: typing.Any) -> None:
        r"""
        Record an adapter option set through direct backend model access.
        """
    def __repr__(self) -> builtins.str: ...

